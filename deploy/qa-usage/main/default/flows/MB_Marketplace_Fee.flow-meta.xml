<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Marketplace new-client fee (MB-MKT): each first purchase arrives as one usage record on Marketplace First Purchase Events (quantity 1, Transaction Amount = the purchase). This flow adds the matching fee record on Marketplace New-Client Fee with quantity = 20% of the purchase, capped at 30, so rating charges the fee per first purchase.</description>
    <environments>Default</environments>
    <formulas>
        <name>FeeAmount</name>
        <dataType>Number</dataType>
        <expression>MIN(ROUND({!$Record.TransactionAmount} * 0.2, 2), 30)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>MB Marketplace Fee {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MB Marketplace Fee</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Fee_Record</name>
        <label>Create fee usage record</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <inputAssignments><field>AccountId</field><value><elementReference>$Record.AccountId</elementReference></value></inputAssignments>
        <inputAssignments><field>ReferenceRecordId</field><value><elementReference>$Record.ReferenceRecordId</elementReference></value></inputAssignments>
        <inputAssignments><field>UsageResourceId</field><value><elementReference>Get_Fee_Resource.Id</elementReference></value></inputAssignments>
        <inputAssignments><field>QuantityUnitOfMeasureId</field><value><elementReference>Get_Fee_Resource.DefaultUnitOfMeasureId</elementReference></value></inputAssignments>
        <inputAssignments><field>Quantity</field><value><elementReference>FeeAmount</elementReference></value></inputAssignments>
        <inputAssignments><field>TransactionAmount</field><value><elementReference>$Record.TransactionAmount</elementReference></value></inputAssignments>
        <inputAssignments><field>UsageType</field><value><elementReference>$Record.UsageType</elementReference></value></inputAssignments>
        <inputAssignments><field>Status</field><value><stringValue>Pending</stringValue></value></inputAssignments>
        <inputAssignments><field>ActivityDate</field><value><elementReference>$Record.ActivityDate</elementReference></value></inputAssignments>
        <inputAssignments><field>StartDate</field><value><elementReference>$Record.StartDate</elementReference></value></inputAssignments>
        <inputAssignments><field>EndDate</field><value><elementReference>$Record.EndDate</elementReference></value></inputAssignments>
        <object>TransactionJournal</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Fee_Resource</name>
        <label>Get fee usage resource</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Create_Fee_Record</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>Code</field><operator>EqualTo</operator><value><stringValue>MB_MKT_FEE</stringValue></value></filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>UsageResource</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Get_Fee_Resource</targetReference></connector>
        <filterFormula>AND({!$Record.UsageResource.Code} = &apos;MB_MKT_FIRST&apos;, {!$Record.TransactionAmount} &gt; 0)</filterFormula>
        <object>TransactionJournal</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
