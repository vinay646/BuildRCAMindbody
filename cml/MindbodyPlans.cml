// ============================================================================
// Mindbody Plans – constraint model (spec 12.3 product rules)
// GENERATED by scripts/build_cml.py from MB_Build_Data.json – do not edit by hand.
// ============================================================================
// Pattern of the org's QuantumBit Bundle model (release 262):
//   * a virtual Quote container that sees every quote line (cart-level rules),
//   * every product is one CML type (Type link), every bundle declares one relation per
//     bundle component (Port link to the ProductRelatedComponent) – loader step `constraints`.
// Design (phase 5): one opportunity and quote per account – every account, location included, can
// buy; billing follows the account's Payer Type. So "per location" rules are "per quote" here.
// ----------------------------------------------------------------------------

// CR-12: hierarchy-wide active locations (Quote > Hierarchy Location Count) from the sales transaction context
@(contextPath = "SalesTransaction.MbHierarchyLocationCount")
extern decimal HierarchyLocations;

@(virtual = "true")
type Quote {
    @(sourceContextNode = "SalesTransaction.SalesTransactionItem")
    relation lineitems : LineItem;

    // CR-05 / CAT-05: AI Concierge is included in Ultimate – no paid add-on next to it
    message(lineitems[Ultimate] > 0 && lineitems[AIConciergeAddOn] > 0,
        "AI Concierge is already included in Ultimate – remove the AI Concierge add-on.", "Error");

    // CR-04 / CFG-03: Starter cannot take AI Concierge or Branded app
    message(lineitems[Starter] > 0 && lineitems[AIConciergeAddOn] > 0,
        "Starter can't add AI Concierge – choose Accelerate or Ultimate.", "Error");
    message(lineitems[Starter] > 0 && lineitems[BrandedApp] > 0,
        "Starter can't add Branded app – choose Accelerate or Ultimate.", "Error");

    // CR-01: one tier per location = one plan per quote (the quote's account is the location)
    constraint(lineitems[Starter] + lineitems[Accelerate] + lineitems[Ultimate] + lineitems[Enterprise] <= 1,
        "Only one plan (Starter, Accelerate, Ultimate or Enterprise) per quote – quote each location on its own account.");

    // CFG-13: no duplicate product per Ship-To = per quote. Tiers are covered by CR-01; add-ons sit in the
    // bundles (max 1); hardware and services may repeat (quantity). Recurring and usage products once only:
    constraint(lineitems[MindbodyPayments] <= 1, "Mindbody Payments is already on this quote – add it once per location.");
    constraint(lineitems[TechnicalAccountManagement] <= 1, "Technical Account Management is already on this quote – add it once per location.");
    constraint(lineitems[MarketplaceFee] <= 1, "Marketplace new-client fee is already on this quote – add it once per location.");
    constraint(lineitems[SmsOverage] <= 1, "SMS overage is already on this quote – add it once per location.");

    // CR-07: one Branded app per brand – once per quote here (across a brand's quotes: checked on assets, phase 6)
    constraint(lineitems[BrandedApp] <= 1,
        "Branded app is sold once per brand – keep one Branded app.");

    // Catalog guidance (Browse Products): grey out add-ons the tier on the quote cannot take
    rule(lineitems[Ultimate] > 0, "disable", "relation", "lineitems", "type", "AIConciergeAddOn",
        "message", "AI Concierge is already included in Ultimate.");
    rule(lineitems[Starter] > 0, "disable", "relation", "lineitems", "type", "AIConciergeAddOn",
        "message", "Starter can't add AI Concierge – choose Accelerate or Ultimate.");
    rule(lineitems[Starter] > 0, "disable", "relation", "lineitems", "type", "BrandedApp",
        "message", "Starter can't add Branded app – choose Accelerate or Ultimate.");

    // Catalog guidance: recommend Mindbody Payments when hardware is on the quote (CR-09)
    rule(lineitems[MobileCardReader], "recommend", "type", "MindbodyPayments", "message", "Hardware requires Mindbody Payments.");
    rule(lineitems[CountertopPaymentTerminal], "recommend", "type", "MindbodyPayments", "message", "Hardware requires Mindbody Payments.");
    rule(lineitems[DoorAccessKit], "recommend", "type", "MindbodyPayments", "message", "Hardware requires Mindbody Payments.");

    // CR-09: hardware needs Mindbody Payments – the configurator adds it (same pattern as QuantumBit's cart-level require)
    require(lineitems[MobileCardReader], lineitems[MindbodyPayments], "Hardware requires Mindbody Payments – added to the quote.");
    require(lineitems[CountertopPaymentTerminal], lineitems[MindbodyPayments], "Hardware requires Mindbody Payments – added to the quote.");
    require(lineitems[DoorAccessKit], lineitems[MindbodyPayments], "Hardware requires Mindbody Payments – added to the quote.");

    // CR-12: recommend Technical Account Management at 10+ locations in the hierarchy, Enterprise at 25+
    rule(HierarchyLocations >= 10 && lineitems[TechnicalAccountManagement] == 0, "recommend", "type", "TechnicalAccountManagement",
        "message", "10 or more locations in this customer's hierarchy – recommend Technical Account Management.");
    rule(HierarchyLocations >= 25 && lineitems[Enterprise] == 0, "recommend", "type", "Enterprise",
        "message", "25 or more locations in this customer's hierarchy – recommend the Enterprise plan.");

    // CR-09 fallback message (shown if Payments is removed again)
    message((lineitems[MobileCardReader] + lineitems[CountertopPaymentTerminal] + lineitems[DoorAccessKit]) > 0
            && lineitems[MindbodyPayments] == 0,
        "Hardware requires Mindbody Payments – add Mindbody Payments (opt in) to the quote.", "Error");
}

// --- Base type ---
type LineItem;

// --- Starter bundle (MB-STR) ---
type Starter : LineItem {
    // CR-11: Prior System attribute (classification Mindbody Subscription Tier); a competitor -> recommend data conversion
    @(defaultValue = "None")
    string MB_Prior_System = ["None", "WellnessLiving", "Vagaro", "Glofox", "Other"];
    rule(MB_Prior_System != "None", "recommend", "type", "CustomDataConversion",
        "message", "The customer is moving from another system – recommend Custom data conversion.");

    // Included Features
    relation str_businessmanagementfeature : BusinessManagementFeature[0..9999];
    relation str_mindbodyapplistingfeature : MindbodyAppListingFeature[0..9999];
    relation str_posandonlinepaymentsfeature : PosAndOnlinePaymentsFeature[0..9999];
    relation str_brandedwebwidgetsfeature : BrandedWebWidgetsFeature[0..9999];
}

// --- Accelerate bundle (MB-ACC) ---
type Accelerate : LineItem {
    // CR-11: Prior System attribute (classification Mindbody Subscription Tier); a competitor -> recommend data conversion
    @(defaultValue = "None")
    string MB_Prior_System = ["None", "WellnessLiving", "Vagaro", "Glofox", "Other"];
    rule(MB_Prior_System != "None", "recommend", "type", "CustomDataConversion",
        "message", "The customer is moving from another system – recommend Custom data conversion.");

    // Included Features
    relation acc_businessmanagementfeature : BusinessManagementFeature[0..9999];
    relation acc_mindbodyapplistingfeature : MindbodyAppListingFeature[0..9999];
    relation acc_posandonlinepaymentsfeature : PosAndOnlinePaymentsFeature[0..9999];
    relation acc_brandedwebwidgetsfeature : BrandedWebWidgetsFeature[0..9999];
    relation acc_resourcemanagementfeature : ResourceManagementFeature[0..9999];
    relation acc_pickaspotfeature : PickASpotFeature[0..9999];
    relation acc_advancedreportingfeature : AdvancedReportingFeature[0..9999];
    relation acc_promocodesfeature : PromoCodesFeature[0..9999];
    // Add-ons
    relation acc_aiconciergeaddon : AIConciergeAddOn[0..9999];
    relation acc_brandedapp : BrandedApp[0..9999];
}

// --- Ultimate bundle (MB-ULT) ---
type Ultimate : LineItem {
    // CR-11: Prior System attribute (classification Mindbody Subscription Tier); a competitor -> recommend data conversion
    @(defaultValue = "None")
    string MB_Prior_System = ["None", "WellnessLiving", "Vagaro", "Glofox", "Other"];
    rule(MB_Prior_System != "None", "recommend", "type", "CustomDataConversion",
        "message", "The customer is moving from another system – recommend Custom data conversion.");

    // Included Features
    relation ult_businessmanagementfeature : BusinessManagementFeature[0..9999];
    relation ult_mindbodyapplistingfeature : MindbodyAppListingFeature[0..9999];
    relation ult_posandonlinepaymentsfeature : PosAndOnlinePaymentsFeature[0..9999];
    relation ult_brandedwebwidgetsfeature : BrandedWebWidgetsFeature[0..9999];
    relation ult_resourcemanagementfeature : ResourceManagementFeature[0..9999];
    relation ult_pickaspotfeature : PickASpotFeature[0..9999];
    relation ult_advancedreportingfeature : AdvancedReportingFeature[0..9999];
    relation ult_promocodesfeature : PromoCodesFeature[0..9999];
    relation ult_emailandsmsmarketingfeature : EmailAndSmsMarketingFeature[0..9999];
    relation ult_leadmanagementfeature : LeadManagementFeature[0..9999];
    relation ult_aiconciergefeature : AiConciergeFeature[0..9999];
    // Add-ons
    relation ult_brandedapp : BrandedApp[0..9999];
}

// --- Enterprise bundle (MB-ENT) ---
type Enterprise : LineItem {
    // CR-11: Prior System attribute (classification Mindbody Subscription Tier); a competitor -> recommend data conversion
    @(defaultValue = "None")
    string MB_Prior_System = ["None", "WellnessLiving", "Vagaro", "Glofox", "Other"];
    rule(MB_Prior_System != "None", "recommend", "type", "CustomDataConversion",
        "message", "The customer is moving from another system – recommend Custom data conversion.");

    // Negotiated Features
    relation ent_businessmanagementfeature : BusinessManagementFeature[0..9999];
    relation ent_mindbodyapplistingfeature : MindbodyAppListingFeature[0..9999];
    relation ent_posandonlinepaymentsfeature : PosAndOnlinePaymentsFeature[0..9999];
    relation ent_brandedwebwidgetsfeature : BrandedWebWidgetsFeature[0..9999];
    relation ent_resourcemanagementfeature : ResourceManagementFeature[0..9999];
    relation ent_pickaspotfeature : PickASpotFeature[0..9999];
    relation ent_advancedreportingfeature : AdvancedReportingFeature[0..9999];
    relation ent_promocodesfeature : PromoCodesFeature[0..9999];
    relation ent_emailandsmsmarketingfeature : EmailAndSmsMarketingFeature[0..9999];
    relation ent_leadmanagementfeature : LeadManagementFeature[0..9999];
    relation ent_aiconciergefeature : AiConciergeFeature[0..9999];
    relation ent_corporatedashboardfeature : CorporateDashboardFeature[0..9999];
    // Add-ons
    relation ent_brandedapp : BrandedApp[0..9999];
}

// --- Branded app bundle (MB-APP) ---
type BrandedApp : LineItem {
    // Setup
    relation app_brandedappsetup : BrandedAppSetup[0..9999];
}

// --- Products without bundle structure ---
type AIConciergeAddOn : LineItem;   // MB-AIC AI Concierge add-on
type AdvancedReportingFeature : LineItem;   // MB-F-REP Advanced Reporting
type AiConciergeFeature : LineItem;   // MB-F-AIC AI Concierge
type BrandedAppSetup : LineItem;   // MB-APP-SET Branded app setup
type BrandedWebWidgetsFeature : LineItem;   // MB-F-WEB Branded Web Widgets
type BusinessManagementFeature : LineItem;   // MB-F-BM Business Management
type CorporateDashboardFeature : LineItem;   // MB-F-CDB Corporate Dashboard
type CountertopPaymentTerminal : LineItem;   // MB-HW-TRM Countertop payment terminal
type CustomDataConversion : LineItem;   // MB-DCV Custom data conversion
type DoorAccessKit : LineItem;   // MB-HW-DOOR Door access kit
type EmailAndSmsMarketingFeature : LineItem;   // MB-F-MKTG Email and SMS Marketing
type LeadManagementFeature : LineItem;   // MB-F-LEAD Lead Management
type MarketplaceFee : LineItem;   // MB-MKT Marketplace new-client fee
type MindbodyAppListingFeature : LineItem;   // MB-F-APPL Mindbody App Listing
type MindbodyPayments : LineItem;   // MB-PAY Mindbody Payments
type MobileCardReader : LineItem;   // MB-HW-RDR Mobile card reader
type PickASpotFeature : LineItem;   // MB-F-PAS Pick-a-Spot
type PosAndOnlinePaymentsFeature : LineItem;   // MB-F-POS POS and Online Payments
type PromoCodesFeature : LineItem;   // MB-F-PROMO Promo Codes
type ResourceManagementFeature : LineItem;   // MB-F-RES Resource Management
type SmsOverage : LineItem;   // MB-SMS SMS overage
type TechnicalAccountManagement : LineItem;   // MB-TAM Technical Account Management
