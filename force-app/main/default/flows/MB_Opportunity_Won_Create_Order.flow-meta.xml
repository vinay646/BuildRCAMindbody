<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Create_Order</name>
        <label>Create the order from the synced quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>createOrderFromQuote</actionName>
        <actionType>createOrderFromQuote</actionType>
        <connector><targetReference>Link_Order</targetReference></connector>
        <faultConnector><targetReference>Record_Error</targetReference></faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>quoteRecordId</name>
            <value><elementReference>$Record.SyncedQuoteId</elementReference></value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <decisions>
        <name>Lines_Complete</name>
        <label>Legal entity and billing treatment on every line?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector><targetReference>Create_Order</targetReference></defaultConnector>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>Line_Missing_Data</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Incomplete_Line</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Record_Line_Error</targetReference></connector>
            <label>No</label>
        </rules>
    </decisions>
    <description>MR-120 (MB-Q2C-03): at Closed Won (or when Retry Order is ticked) and with no order yet, checks that every line of the synced quote has a legal entity and a billing treatment, creates the order with the standard Create Order from Quote action, links it on the opportunity and stamps ARR, MRR and one-time bookings. Failures fill Order Error and give the owner a task; Retry Order runs it again. Runs after the save (asynchronous path).</description>
    <environments>Default</environments>
    <formulas>
        <name>fLineError</name>
        <dataType>String</dataType>
        <expression>"Legal entity or billing treatment missing on a line."</expression>
    </formulas>
    <formulas>
        <name>fTaskText</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Flow.FaultMessage}), {!fLineError}, {!$Flow.FaultMessage})</expression>
    </formulas>
    <interviewLabel>MB Opportunity Won Create Order {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MB Opportunity Won Create Order</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Task_To_Owner</name>
        <label>Task to the owner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments><field>Description</field><value><elementReference>fTaskText</elementReference></value></inputAssignments>
        <inputAssignments><field>OwnerId</field><value><elementReference>$Record.OwnerId</elementReference></value></inputAssignments>
        <inputAssignments><field>Subject</field><value><stringValue>Order not created – fix the Order Error and tick Retry Order</stringValue></value></inputAssignments>
        <inputAssignments><field>WhatId</field><value><elementReference>$Record.Id</elementReference></value></inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Incomplete_Line</name>
        <label>Get a line without legal entity or billing treatment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Lines_Complete</targetReference></connector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters><field>QuoteId</field><operator>EqualTo</operator><value><elementReference>$Record.SyncedQuoteId</elementReference></value></filters>
        <filters><field>LegalEntityId</field><operator>IsNull</operator><value><booleanValue>true</booleanValue></value></filters>
        <filters><field>BillingTreatmentId</field><operator>IsNull</operator><value><booleanValue>true</booleanValue></value></filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>QuoteLineItem</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Link_Order</name>
        <label>Link the order and stamp bookings</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters><field>Id</field><operator>EqualTo</operator><value><elementReference>$Record.Id</elementReference></value></filters>
        <inputAssignments><field>MB_Bookings_ARR__c</field><value><elementReference>$Record.SyncedQuote.MB_ARR__c</elementReference></value></inputAssignments>
        <inputAssignments><field>MB_Bookings_MRR__c</field><value><elementReference>$Record.SyncedQuote.MB_MRR__c</elementReference></value></inputAssignments>
        <inputAssignments><field>MB_Bookings_One_Time__c</field><value><elementReference>$Record.SyncedQuote.MB_One_Time__c</elementReference></value></inputAssignments>
        <inputAssignments><field>MB_Order_Error__c</field><value><stringValue></stringValue></value></inputAssignments>
        <inputAssignments><field>MB_Order__c</field><value><elementReference>Create_Order.orderId</elementReference></value></inputAssignments>
        <inputAssignments><field>MB_Retry_Order__c</field><value><booleanValue>false</booleanValue></value></inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Record_Error</name>
        <label>Record the error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Task_To_Owner</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>Id</field><operator>EqualTo</operator><value><elementReference>$Record.Id</elementReference></value></filters>
        <inputAssignments><field>MB_Order_Error__c</field><value><elementReference>$Flow.FaultMessage</elementReference></value></inputAssignments>
        <inputAssignments><field>MB_Retry_Order__c</field><value><booleanValue>false</booleanValue></value></inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Record_Line_Error</name>
        <label>Record the line error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Task_To_Owner</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>Id</field><operator>EqualTo</operator><value><elementReference>$Record.Id</elementReference></value></filters>
        <inputAssignments><field>MB_Order_Error__c</field><value><elementReference>fLineError</elementReference></value></inputAssignments>
        <inputAssignments><field>MB_Retry_Order__c</field><value><booleanValue>false</booleanValue></value></inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>(1 AND 2 AND 3) OR (4 AND 5 AND 3 AND 1)</filterLogic>
        <filters><field>StageName</field><operator>EqualTo</operator><value><stringValue>Closed Won</stringValue></value></filters>
        <filters><field>StageName</field><operator>IsChanged</operator><value><booleanValue>true</booleanValue></value></filters>
        <filters><field>MB_Order__c</field><operator>IsNull</operator><value><booleanValue>true</booleanValue></value></filters>
        <filters><field>MB_Retry_Order__c</field><operator>EqualTo</operator><value><booleanValue>true</booleanValue></value></filters>
        <filters><field>MB_Retry_Order__c</field><operator>IsChanged</operator><value><booleanValue>true</booleanValue></value></filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector><targetReference>Get_Incomplete_Line</targetReference></connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
