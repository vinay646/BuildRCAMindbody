    <customErrors>
        <name>Error_One_Plan</name>
        <label>Error one plan</label>
        <locationX>50</locationX>
        <locationY>1271</locationY>
        <customErrorMessages>
            <errorMessage>Only one plan (Starter, Accelerate, Ultimate or Enterprise) per quote. Quote each location on its own account. (CR-01)</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Error_Duplicate_Product</name>
        <label>Error duplicate product</label>
        <locationX>446</locationX>
        <locationY>755</locationY>
        <customErrorMessages>
            <errorMessage>{!$Record.Product2.Name} is already on this quote. Add it once per location. (CFG-13)</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Line_Kind</name>
        <label>Line kind</label>
        <locationX>380</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Other product</defaultConnectorLabel>
        <rules>
            <name>Is_Plan</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fIsPlan</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Add_Plan_Codes</targetReference></connector>
            <label>Plan</label>
        </rules>
        <rules>
            <name>Is_Once_Per_Quote</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fIsOncePerQuote</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Get_Same_Product_Lines</targetReference></connector>
            <label>Once per quote</label>
        </rules>
    </decisions>
    <decisions>
        <name>More_Than_One_Plan</name>
        <label>More than one plan</label>
        <locationX>176</locationX>
        <locationY>1163</locationY>
        <defaultConnectorLabel>One plan</defaultConnectorLabel>
        <rules>
            <name>Two_Or_More_Plans</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>planLineCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue><numberValue>1.0</numberValue></rightValue>
            </conditions>
            <connector><targetReference>Error_One_Plan</targetReference></connector>
            <label>Two or more plans</label>
        </rules>
    </decisions>
    <decisions>
        <name>Product_Repeated</name>
        <label>Product repeated</label>
        <locationX>578</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Once</defaultConnectorLabel>
        <rules>
            <name>Repeated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sameProductCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue><numberValue>1.0</numberValue></rightValue>
            </conditions>
            <connector><targetReference>Error_Duplicate_Product</targetReference></connector>
            <label>Repeated</label>
        </rules>
    </decisions>
    <description>CR-01 one plan per quote and CFG-13 no repeated Payments, TAM, Marketplace fee or SMS line on a quote (design: one quote per account). Hard block, because constraint model constraints only warn and validation rules cannot count sibling lines.</description>
    <environments>Default</environments>
    <formulas>
        <name>fIsPlan</name>
        <dataType>Boolean</dataType>
        <expression>OR({!$Record.Product2.ProductCode} = 'MB-STR', {!$Record.Product2.ProductCode} = 'MB-ACC', {!$Record.Product2.ProductCode} = 'MB-ULT', {!$Record.Product2.ProductCode} = 'MB-ENT')</expression>
    </formulas>
    <formulas>
        <name>fIsOncePerQuote</name>
        <dataType>Boolean</dataType>
        <expression>OR({!$Record.Product2.ProductCode} = 'MB-PAY', {!$Record.Product2.ProductCode} = 'MB-TAM', {!$Record.Product2.ProductCode} = 'MB-MKT', {!$Record.Product2.ProductCode} = 'MB-SMS')</expression>
    </formulas>
    <interviewLabel>MB Quote Line One Plan No Duplicates {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MB Quote Line One Plan No Duplicates</label>
    <loops>
        <name>Loop_Plan_Products</name>
