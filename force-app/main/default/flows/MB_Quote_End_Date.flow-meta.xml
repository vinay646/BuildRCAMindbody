<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Set_End_Date</name>
        <label>Set end date</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.RLM_EndDate__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>fEndDate</elementReference></value>
        </assignmentItems>
    </assignments>
    <description>Quote End Date = Start Date + Term (Months) - 1 day.</description>
    <environments>Default</environments>
    <formulas>
        <name>fEndDate</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!$Record.StartDate}, {!$Record.RLM_TermMonths__c}) - 1</expression>
    </formulas>
    <interviewLabel>MB Quote End Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MB Quote End Date</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Set_End_Date</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StartDate</field>
            <operator>IsNull</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <filters>
            <field>RLM_TermMonths__c</field>
            <operator>GreaterThan</operator>
            <value><numberValue>0.0</numberValue></value>
        </filters>
        <object>Quote</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
