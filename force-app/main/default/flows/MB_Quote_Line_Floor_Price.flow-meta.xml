<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Set_Floor_Price</name>
        <label>Set floor price</label>
        <locationX>50</locationX>
        <locationY>719</locationY>
        <assignmentItems>
            <assignToReference>$Record.MB_Floor_Price__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Get_Floor_Entry.UnitPrice</elementReference></value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Floor_Book_Found</name>
        <label>Floor price book found</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Book_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Floor_Book</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Get_Floor_Entry</targetReference></connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Floor_Entry_Found</name>
        <label>Floor price found</label>
        <locationX>182</locationX>
        <locationY>611</locationY>
        <defaultConnectorLabel>No floor for this product</defaultConnectorLabel>
        <rules>
            <name>Entry_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Floor_Entry</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Set_Floor_Price</targetReference></connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>PRC-18: sets Quote Line Item › Floor Price from the "Mindbody Floor Prices" price book (line product, quote currency). Below Floor (formula: Net Unit Price &lt; Floor Price) drives the VP Sales then Finance approval. Products without a floor entry keep Floor Price blank. Done in a flow because the pricing procedure's price-book lookup only supports the quote's own price book.</description>
    <environments>Default</environments>
    <interviewLabel>MB Quote Line Floor Price {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MB Quote Line Floor Price</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Floor_Book</name>
        <label>Get floor price book</label>
        <locationX>182</locationX>
        <locationY>179</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Floor_Book_Found</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value><stringValue>Mindbody Floor Prices</stringValue></value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value><booleanValue>true</booleanValue></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Pricebook2</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Floor_Entry</name>
        <label>Get floor price entry</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Floor_Entry_Found</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Pricebook2Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>Get_Floor_Book.Id</elementReference></value>
        </filters>
        <filters>
            <field>Product2Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Product2Id</elementReference></value>
        </filters>
        <filters>
            <field>CurrencyIsoCode</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.CurrencyIsoCode</elementReference></value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value><booleanValue>true</booleanValue></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PricebookEntry</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>UnitPrice</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Get_Floor_Book</targetReference></connector>
        <filterFormula>OR(ISNEW(), ISCHANGED({!$Record.Product2Id}), ISBLANK({!$Record.MB_Floor_Price__c}))</filterFormula>
        <object>QuoteLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
