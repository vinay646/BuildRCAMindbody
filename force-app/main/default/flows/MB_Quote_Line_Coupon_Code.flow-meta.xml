<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Reprice_Quote</name>
        <label>Reprice quote</label>
        <locationX>600</locationX>
        <locationY>200</locationY>
        <actionName>RepriceQuotesPST</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>ids</name>
            <value><elementReference>$Record.QuoteId</elementReference></value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <description>A line added to a quote that has a Coupon Code gets a 0% Promotion price adjustment carrying that code (upper case), and the Run Asynchronously path reprices the quote (Apex action RepriceQuotesPST, after the save commits), which applies the coupon's promotion to it when the product is eligible.</description>
    <environments>Default</environments>
    <formulas>
        <name>fCoupon</name>
        <dataType>String</dataType>
        <expression>UPPER(TRIM({!$Record.Quote.Coupon_Code__c}))</expression>
    </formulas>
    <interviewLabel>MB Quote Line Coupon Code {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MB Quote Line Coupon Code</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Placeholder</name>
        <label>Create coupon placeholder</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <inputAssignments>
            <field>QuoteLineItemId</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>AdjustmentSource</field>
            <value><stringValue>Promotion</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>AdjustmentType</field>
            <value><stringValue>AdjustmentPercentage</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>AdjustmentValue</field>
            <value><numberValue>0.0</numberValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>CouponCode</field>
            <value><elementReference>fCoupon</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value><stringValue>Quote coupon code</stringValue></value>
        </inputAssignments>
        <object>QuoteLinePriceAdjustment</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Create_Placeholder</targetReference></connector>
        <filterFormula>NOT(ISBLANK({!$Record.Quote.Coupon_Code__c}))</filterFormula>
        <object>QuoteLineItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <name>Reprice_After_Commit</name>
            <connector><targetReference>Reprice_Quote</targetReference></connector>
            <label>Reprice after commit</label>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
