<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Sync_Coupon</name>
        <label>Sync quote coupon</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <actionName>MbCouponSync</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>quoteIds</name>
            <value><elementReference>$Record.QuoteId</elementReference></value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <description>A line added to a quote that has a Coupon Code: Apex MbCouponSync checks the coupon rules again with the new lines. If the quote qualifies now, every line gets the coupon (0% Promotion placeholder carrying the code) and the quote is repriced, which applies the promotion to its eligible products. If not yet (for example Starter added before Payments), the coupon waits on the quote with no error and applies when the missing product is added. So the coupon can be entered before any product.</description>
    <environments>Default</environments>
    <interviewLabel>MB Quote Line Coupon Code {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MB Quote Line Coupon Code</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Sync_Coupon</targetReference></connector>
        <filterFormula>NOT(ISBLANK({!$Record.Quote.Coupon_Code__c}))</filterFormula>
        <object>QuoteLineItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
