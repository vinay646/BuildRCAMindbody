<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>When the promotion engine adds a promotion price adjustment that carries a coupon code to a quote line, the line's 0% "Quote coupon code" placeholder for the same code (added by MB Quote Coupon Code / MB Quote Line Coupon Code) is no longer needed and is deleted, so the line shows only the real promotion. Runs after the save commits.</description>
    <environments>Default</environments>
    <interviewLabel>MB Quote Line Coupon Placeholder Cleanup {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MB Quote Line Coupon Placeholder Cleanup</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordDeletes>
        <name>Delete_Placeholder</name>
        <label>Delete coupon placeholder</label>
        <locationX>314</locationX>
        <locationY>276</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QuoteLineItemId</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.QuoteLineItemId</elementReference></value>
        </filters>
        <filters>
            <field>CouponCode</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.CouponCode</elementReference></value>
        </filters>
        <filters>
            <field>PriceAdjustmentCauseId</field>
            <operator>IsNull</operator>
            <value><booleanValue>true</booleanValue></value>
        </filters>
        <filters>
            <field>Description</field>
            <operator>EqualTo</operator>
            <value><stringValue>Quote coupon code</stringValue></value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value><elementReference>$Record.Id</elementReference></value>
        </filters>
        <object>QuoteLinePriceAdjustment</object>
    </recordDeletes>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PriceAdjustmentCauseId</field>
            <operator>IsNull</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <filters>
            <field>CouponCode</field>
            <operator>IsNull</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <object>QuoteLinePriceAdjustment</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <name>After_Commit</name>
            <connector><targetReference>Delete_Placeholder</targetReference></connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
