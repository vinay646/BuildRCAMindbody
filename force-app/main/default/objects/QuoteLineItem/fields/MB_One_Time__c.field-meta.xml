<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MB_One_Time__c</fullName>
    <label>One-Time Value</label>
    <description>MR-120: total of a one-time line (no billing frequency).</description>
    <type>Currency</type><precision>16</precision><scale>2</scale>
    <formula>IF(ISPICKVAL(BillingFrequency, ""), NetUnitPrice * Quantity, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
</CustomField>
